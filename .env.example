# Choose "stepfun" for the current default, or "gemini" for the optional provider.
CODEX_VIDEO_PROVIDER=stepfun

# StepFun: the official Open Platform API is the default channel.
# For Step Plan Credit, change STEPFUN_BASE_URL to:
# https://api.stepfun.com/step_plan/v1
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
# Optional compatibility-test overrides only. The stable defaults remain
# step-3.7-flash and stepaudio-2.5-asr; do not change them for the normal path.
# STEPFUN_VIDEO_MODEL=step-3.7-flash
# STEPFUN_ASR_MODEL=stepaudio-2.5-asr
# Example newer-model compatibility test:
# STEPFUN_VIDEO_MODEL=step-5-preview
# StepAudio 3 ASR compatibility test via the official Open Platform, not Step Plan:
# STEPFUN_BASE_URL=https://api.stepfun.com/v1
# STEPFUN_ASR_MODEL=stepaudio-3-asr-max

# Gemini is optional and requires a project with Gemini API access.
# GEMINI_API_KEY=
# GEMINI_VIDEO_MODEL=gemini-2.5-flash

# Optional. Override the bundled ffmpeg-static binary if your platform cannot use it.
# FFMPEG_PATH=/absolute/path/to/ffmpeg

# Optional. A user-authorized Netscape-format Bilibili cookies file for login-gated
# downloads. Never commit the file or paste its contents into chat.
# BILIBILI_COOKIES_FILE=/absolute/path/to/cookies.txt

# Catalyst acquisition overrides. The optional bundled yt-dlp may be unavailable.
# YTDLP_PATH=/absolute/path/to/yt-dlp
# YTDLP_PYTHON=/absolute/path/to/python3
# YouTube authentication is opt-in and separate from Bilibili authentication.
# YOUTUBE_COOKIES_FILE=/absolute/path/to/youtube-cookies.txt
# YOUTUBE_COOKIES_FROM_BROWSER=firefox

# Xiaohongshu authentication is also opt-in and isolated from other platforms.
# Keep original share URL parameters; never copy cookies or signed media URLs into chat.
# XIAOHONGSHU_COOKIES_FILE=/absolute/path/to/xiaohongshu-cookies.txt
# XIAOHONGSHU_COOKIES_FROM_BROWSER=firefox

# Image-note OCR: auto prefers local macOS Swift/Vision, falling back to the
# configured model provider. Explicit alternatives: provider or apple_vision.
# CATALYST_OCR_ENGINE=auto

# Long-video progress is saved locally unless save_session is false.
# Defaults to ~/.catalyst/sessions; no media files or credentials are retained.
# CATALYST_SESSION_DIR=/absolute/path/to/catalyst-sessions
